{
  "name": "exatech-platform",
  "private": true,
  "version": "1.0.0",
  "packageManager": "pnpm@10.21.0",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "build": "turbo run build",
    "build:packages": "turbo run build --filter=./packages/*",
    "dev": "turbo run dev --parallel",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "lint": "turbo run lint",
    "db:generate": "pnpm --filter @exatech/db generate",
    "db:migrate": "pnpm --filter @exatech/db migrate",
    "db:seed": "pnpm --filter @exatech/db seed && pnpm --filter @exatech/api seed:files",
    "db:reset": "pnpm --filter @exatech/db reset",
    "setup:local": "node scripts/setup-local.mjs",
    "e2e": "pnpm --filter @exatech/web e2e"
  },
  "devDependencies": {
    "turbo": "2.11.7",
    "typescript": "5.9.3",
    "@types/node": "22.19.1"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "sharp",
      "@swc/core",
      "msgpackr-extract",
      "unrs-resolver"
    ]
  }
}
