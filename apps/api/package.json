{
  "name": "@exatech/api",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "dev": "nest start --watch --preserveWatchOutput",
    "dev:worker": "nest start --watch --entryFile worker --preserveWatchOutput",
    "start": "node dist/main.js",
    "start:worker": "node dist/worker.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "seed:files": "node dist/scripts/seed-files.js"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "3.1149.0",
    "@aws-sdk/s3-request-presigner": "3.1149.0",
    "@exatech/contracts": "workspace:*",
    "@exatech/db": "workspace:*",
    "@exatech/domain": "workspace:*",
    "@fastify/cookie": "11.1.3",
    "@fastify/helmet": "13.1.2",
    "@fastify/multipart": "9.4.0",
    "@nestjs/common": "11.2.7",
    "@nestjs/core": "11.2.7",
    "@nestjs/platform-fastify": "11.2.7",
    "@pdf-lib/fontkit": "1.1.1",
    "better-auth": "1.3.34",
    "bullmq": "5.81.5",
    "bwip-js": "4.11.4",
    "exceljs": "4.4.0",
    "fastify": "5.11.3",
    "ioredis": "5.11.1",
    "nodemailer": "7.0.13",
    "papaparse": "5.7.0",
    "pdf-lib": "1.17.1",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "zod": "4.1.13"
  },
  "devDependencies": {
    "@nestjs/cli": "11.0.24",
    "@types/node": "22.19.1",
    "@types/nodemailer": "7.0.12",
    "@types/papaparse": "5.5.2",
    "typescript": "5.9.3",
    "vitest": "3.2.7"
  }
}
