# Copy to apps/api/.env for local development.
NODE_ENV=development
API_PORT=4300
WEB_ORIGIN=http://localhost:3300
DATABASE_URL=postgres://localhost:5432/exatech
REDIS_URL=redis://localhost:6379/0
REDIS_PREFIX=exa
AUTH_SECRET=change-me-to-a-long-random-string-of-32-chars-or-more
# Demo personas on the sign-in page + /dev/outbox. NEVER enable in production.
DEMO_MODE=true

# Object storage (MinIO locally, S3/R2 in production)
S3_ENDPOINT=http://localhost:9000
S3_REGION=ap-south-1
S3_BUCKET=exatech
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_FORCE_PATH_STYLE=true

# Email: Mailpit locally (SMTP 1025, UI 8025); set RESEND_API_KEY to use Resend instead
SMTP_HOST=localhost
SMTP_PORT=1025
MAIL_FROM=Exatech <no-reply@exatech.test>
# RESEND_API_KEY=

# Optional integrations (sandboxes are used when unset)
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# WHATSAPP_TOKEN=
# WHATSAPP_PHONE_NUMBER_ID=
# RAZORPAY_KEY_ID=
# RAZORPAY_KEY_SECRET=
# RAZORPAY_WEBHOOK_SECRET=
SANDBOX_WEBHOOK_SECRET=sandbox-webhook-secret
# Optional: "Draft with AI" on announcements
# ANTHROPIC_API_KEY=

# Web app (apps/web): where Next proxies /api
# API_URL=http://localhost:4300
